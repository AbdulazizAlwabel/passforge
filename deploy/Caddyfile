# Caddy in front of the Node server, behind Cloudflare's proxy.
# Cloudflare terminates public HTTPS; Caddy serves the origin with its own
# internal certificate (Cloudflare SSL mode "Full"). For "Full (strict)",
# replace `tls internal` with: tls /etc/caddy/origin.pem /etc/caddy/origin.key
# (a Cloudflare Origin CA certificate).
{
	skip_install_trust
	servers {
		# Trust Cloudflare's edge so the real visitor IP reaches the app.
		# Source: https://www.cloudflare.com/ips/ (refresh occasionally)
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

nicelydone.qd.je {
	tls internal
	encode zstd gzip
	reverse_proxy 127.0.0.1:3080
}

www.nicelydone.qd.je {
	tls internal
	redir https://nicelydone.qd.je{uri} permanent
}
