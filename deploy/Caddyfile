# Caddy serves nicelydone.qd.je directly (DNS A record at DigitalPlat → this VM).
# Let's Encrypt's per-domain limit is exhausted for *.qd.je (shared by every
# DigitalPlat user), so certificates come from ZeroSSL first, LE as fallback.
{
	email {$ACME_EMAIL}
	cert_issuer acme https://acme.zerossl.com/v2/DV90
	cert_issuer acme
}

nicelydone.qd.je {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3080
}

www.nicelydone.qd.je {
	redir https://nicelydone.qd.je{uri} permanent
}

# Other sites on this VM (Daftar, the desktop relay, ...) live in their own
# files there and are never in this repo. install-vm.sh creates the folder;
# Caddy accepts the glob when it matches nothing.
import /etc/caddy/sites.d/*.caddy
