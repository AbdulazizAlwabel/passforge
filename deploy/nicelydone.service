# systemd unit for the Node server.
# Copy to /etc/systemd/system/nicelydone.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now nicelydone
[Unit]
Description=Nicely Done (site + account API)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=nicelydone
WorkingDirectory=/opt/nicelydone/server
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/nicelydone

[Install]
WantedBy=multi-user.target
