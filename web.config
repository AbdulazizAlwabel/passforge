<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Custom error pages -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
  <remove statusCode="404" subStatusCode="-1"/>
  <error statusCode="404" path="/404.html" responseMode="ExecuteURL"/>
  <remove statusCode="403" subStatusCode="-1"/>
  <error statusCode="403" path="/404.html" responseMode="ExecuteURL"/>
  <remove statusCode="500" subStatusCode="-1"/>
  <error statusCode="500" path="/404.html" responseMode="ExecuteURL"/>
</httpErrors>

    <!-- Default document -->
    <defaultDocument>
      <files>
        <clear/>
        <add value="index.html"/>
      </files>
    </defaultDocument>

    <!-- Rewrite rules -->
    <rewrite>
      <rules>
        <rule name="Reverse Proxy to Node API" stopProcessing="true">
          <match url="^api/(.*)"/>
          <action type="Rewrite" url="http://127.0.0.1:3000/api/{R:1}"/>
        </rule>
        <rule name="Remove index.html" stopProcessing="true">
          <match url="^index\.html$"/>
          <conditions><add input="{REQUEST_METHOD}" pattern="^GET$"/></conditions>
          <action type="Redirect" url="/" redirectType="Permanent"/>
        </rule>
        <rule name="Clean URL Password Generator" stopProcessing="true">
          <match url="^password-generator$"/>
          <action type="Rewrite" url="password-generator.html"/>
        </rule>
        <rule name="Clean URL Username Generator" stopProcessing="true">
          <match url="^username-generator$"/>
          <action type="Rewrite" url="username-generator.html"/>
        </rule>
        <rule name="Clean URL Strength Checker" stopProcessing="true">
          <match url="^strength-checker$"/>
          <action type="Rewrite" url="strength-checker.html"/>
        </rule>
        <rule name="Clean URL Hash Generator" stopProcessing="true">
          <match url="^hash-generator$"/>
          <action type="Rewrite" url="hash-generator.html"/>
        </rule>
        <rule name="Clean URL Base64 Tool" stopProcessing="true">
          <match url="^base64-tool$"/>
          <action type="Rewrite" url="base64-tool.html"/>
        </rule>
        <rule name="Clean URL Json Formatter" stopProcessing="true">
          <match url="^json-formatter$"/>
          <action type="Rewrite" url="json-formatter.html"/>
        </rule>
        <rule name="Clean URL Ip Network" stopProcessing="true">
          <match url="^ip-network$"/>
          <action type="Rewrite" url="ip-network.html"/>
        </rule>
        <rule name="Clean URL Text Converter" stopProcessing="true">
          <match url="^text-converter$"/>
          <action type="Rewrite" url="text-converter.html"/>
        </rule>
        <rule name="Clean URL Unit Converter" stopProcessing="true">
          <match url="^unit-converter$"/>
          <action type="Rewrite" url="unit-converter.html"/>
        </rule>
        <rule name="Clean URL Date Converter" stopProcessing="true">
          <match url="^date-converter$"/>
          <action type="Rewrite" url="date-converter.html"/>
        </rule>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)"/>
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$"/>
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent"/>
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
