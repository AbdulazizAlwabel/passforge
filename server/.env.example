# ── Server ───────────────────────────────────────
PORT=3080
NODE_ENV=production
# Public URL of the site (used in email links and CORS)
SITE_URL=https://nicelydone.qd.je
# Where the built site lives (run `python3 build.py` in the project root)
STATIC_DIR=../dist
# Set to 1 when running behind a reverse proxy (Caddy, nginx, IIS ARR)
TRUST_PROXY=1

# ── Auth ─────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 64 hex chars; encrypts two-factor secrets at rest. Generate: openssl rand -hex 32
TOTP_ENC_KEY=
# Comma-separated numeric user ids with admin access (see the users table)
ADMIN_USER_IDS=

# ── MySQL / MariaDB ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=passforge_app
DB_PASSWORD=
DB_NAME=passforge

# ── Email (SMTP) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Nicely Done
MAIL_FROM_ADDRESS=no-reply@nicelydone.qd.je
